        "rng = np.random.default_rng(0)\n",
        "N = 8\n",
        "x = rng.standard_normal(N)\n",
        "h = rng.standard_normal(N)\n",
        "X = dft(x)\n",
        "H = dft(h)\n",
        "n = np.arange(N)\n",
        "k = np.arange(N)\n",
        "\n",
        "def conv_circular(a, b):\n",
        "    N = len(a)\n",
        "    z = np.zeros(N, dtype=complex)\n",
        "    for i in range(N):\n",
        "        for m in range(N):\n",
        "            z[i] += a[m] * b[(i - m) % N]\n",
        "    return z\n",
        "\n",
        "# 1. linearidade: αx1 + βx2 -> αX1 + βX2\n",
        "alfa, beta = 2, -3\n",
        "print(\"1. Linearidade:\", np.allclose(dft(alfa*x + beta*h), alfa*X + beta*H))\n",
        "\n",
        "# 2. deslocamento no tempo: x[(n-n0) mod N] -> e^(-j2πkn0/N) X[k]\n",
        "n0 = 3\n",
        "print(\"2. Deslocamento no tempo:\", np.allclose(dft(np.roll(x, n0)), np.exp(-1j*2*np.pi*k*n0/N) * X))\n",
        "\n",
        "# 3. deslocamento na frequência: x[n] e^(j2πk0n/N) -> X[(k-k0) mod N]\n",
        "k0 = 2\n",
        "print(\"3. Deslocamento na frequência:\", np.allclose(dft(x * np.exp(1j*2*np.pi*k0*n/N)), np.roll(X, k0)))\n",
        "\n",
        "# 4. reversão temporal: x[(-n) mod N] -> X[(-k) mod N]\n",
        "print(\"4. Reversão temporal:\", np.allclose(dft(x[(-n) % N]), X[(-k) % N]))\n",
        "\n",
        "# 5. conjugação complexa: x*[n] -> X*[(-k) mod N] (testada com sinal complexo)\n",
        "xc = rng.standard_normal(N) + 1j * rng.standard_normal(N)\n",
        "Xc = dft(xc)\n",
        "print(\"5. Conjugação complexa:\", np.allclose(dft(np.conj(xc)), np.conj(Xc[(-k) % N])))\n",
        "\n",
        "# 6. convolução circular: x ⊛ h -> √N X[k] H[k]\n",
        "print(\"6. Convolução circular:\", np.allclose(dft(conv_circular(x, h)), np.sqrt(N) * X * H))\n",
        "\n",
        "# 7. multiplicação ponto a ponto: x[n] h[n] -> (1/√N) (X ⊛ H)\n",
        "print(\"7. Multiplicação ponto a ponto:\", np.allclose(dft(x * h), conv_circular(X, H) / np.sqrt(N)))\n",
        "\n",
        "# 8. Parseval: Σ x[n] y*[n] = Σ X[k] Y*[k]\n",
        "print(\"8. Parseval:\", np.allclose(np.sum(x * np.conj(h)), np.sum(X * np.conj(H))))\n",
        "\n",
        "# 9. periodicidade: X[k + N] = X[k] (fórmula da DFT calculada para k = 0, ..., 2N-1)\n",
        "X_estendida = np.array([np.sum(x * np.exp(-1j*2*np.pi*kk*n/N)) / np.sqrt(N) for kk in range(2*N)])\n",
        "print(\"9. Periodicidade:\", np.allclose(X_estendida[N:], X_estendida[:N]))\n",
        "\n",
        "# 10. simetria para sinais reais: X[N-k] = X*[k]\n",
        "print(\"10. Simetria para sinais reais:\", np.allclose(X[(N - k) % N], np.conj(X)))\n",
        "\n",
        "# 11. amostragem no tempo: manter só x[Mn] -> DFT de x[Mn] repetida M vezes\n",
        "M = 2\n",
        "x_amostrado = np.zeros(N)\n",
        "x_amostrado[::M] = x[::M]\n",
        "print(\"11. Amostragem no tempo:\", np.allclose(dft(x_amostrado), np.tile(dft(x[::M]), M) / np.sqrt(M)))\n",
        "\n",
        "# 12. amostragem na frequência: zero-padding até N > L -> DTFT amostrada em N pontos\n",
        "L = 4\n",
        "x_curto = rng.standard_normal(L)\n",
        "x_zp = np.concatenate([x_curto, np.zeros(N - L)])\n",
        "dtft = lambda f: np.sum(x_curto * np.exp(-1j*2*np.pi*f*np.arange(L)))\n",
        "print(\"12. Amostragem na frequência:\", np.allclose(dft(x_zp), np.array([dtft(kk/N) for kk in range(N)]) / np.sqrt(N)))"
      ],
