        "## 5. Implementação da FFT (radix-2)\n",
        "Algoritmo de Cooley-Tukey recursivo, com a mesma normalização 1/√N."
      ],
      "metadata": {
        "id": "V8PBMN7WBfd2"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def fft_rec(x):\n",
        "    N = len(x)\n",
        "\n",
        "    # caso base: a DFT de 1 amostra é ela mesma\n",
        "    if N == 1:\n",
        "        return x\n",
        "    if N % 2 != 0:\n",
        "        raise ValueError(\"N deve ser potência de 2\")\n",
        "\n",
        "    # divide em pares e ímpares e calcula a FFT de cada metade\n",
        "    X_par = fft_rec(x[0::2])\n",
        "    X_impar = fft_rec(x[1::2])\n",
        "\n",
        "    # combina as duas metades (borboleta)\n",
        "    k = np.arange(N // 2)\n",
        "    W = np.exp(-1j * 2 * np.pi * k / N)\n",
        "    return np.concatenate([X_par + W * X_impar, X_par - W * X_impar])\n",
        "\n",
        "\n",
        "def fft(x):\n",
        "    x = np.asarray(x, dtype=complex)\n",
        "    return fft_rec(x) / np.sqrt(len(x))  # mesma normalização 1/√N dos slides\n",
        "\n",
        "\n",
        "x = rng.standard_normal(16)\n",
        "print(\"FFT = DFT:           \", np.allclose(fft(x), dft(x)))\n",
        "print(\"FFT = np.fft (ortho):\", np.allclose(fft(x), np.fft.fft(x, norm=\"ortho\")))"
      ],
