      "source": [
        "import numpy as np\n",
        "\n",
        "def dft(x):\n",
        "    x = np.asarray(x, dtype=complex)\n",
        "    N = len(x)\n",
        "    X = np.zeros(N, dtype=complex)\n",
        "    for k in range(N):\n",
        "        soma = 0\n",
        "        for n in range(N):\n",
        "            soma += x[n] * np.exp(-1j * 2 * np.pi * k * n / N)\n",
        "        X[k] = soma / np.sqrt(N)\n",
        "    return X\n",
        "\n",
        "\n",
        "def idft(X):\n",
        "    X = np.asarray(X, dtype=complex)\n",
        "    N = len(X)\n",
        "    x = np.zeros(N, dtype=complex)\n",
        "    for n in range(N):\n",
        "        soma = 0\n",
        "        for k in range(N):\n",
        "            soma += X[k] * np.exp(1j * 2 * np.pi * k * n / N)\n",
        "        x[n] = soma / np.sqrt(N)\n",
        "    return x\n",
        "\n",
        "\n",
        "x = [3, 5, 6, 7]\n",
        "print(\"DFT = np.fft (ortho):\", np.allclose(dft(x), np.fft.fft(x, norm=\"ortho\")))\n",
        "print(\"IDFT(DFT(x)) = x:    \", np.allclose(idft(dft(x)), x))\n",
        "print(\"Exemplo do slide 9:  \", np.round(dft([1, 1, 1, 1, 0, 0, 0, 0]), 2))"
      ]
