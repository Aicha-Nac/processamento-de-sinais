        "## 3. Convolução linear via DFT/IDFT\n",
        "Convolução linear a partir da convolução circular, com zero-padding até N + M − 1 amostras."
      ],
      "metadata": {
        "id": "tMYtJhpeBYWd"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def conv_linear_dft(x, h):\n",
        "    x = np.asarray(x, dtype=float)\n",
        "    h = np.asarray(h, dtype=float)\n",
        "    L = len(x) + len(h) - 1\n",
        "\n",
        "    # zero-padding até o tamanho L = N + M - 1\n",
        "    xp = np.concatenate([x, np.zeros(L - len(x))])\n",
        "    hp = np.concatenate([h, np.zeros(L - len(h))])\n",
        "\n",
        "    # convolução circular = √L · X[k] · H[k] na frequência (normalização 1/√N)\n",
        "    y = idft(np.sqrt(L) * dft(xp) * dft(hp))\n",
        "\n",
        "    # o resultado é real; a parte imaginária é só erro de arredondamento\n",
        "    return np.real(y)\n",
        "\n",
        "\n",
        "x = [1, 2, 3, 4]\n",
        "h = [1, 1, 1]\n",
        "\n",
        "print(\"Com zero-padding:\", np.round(conv_linear_dft(x, h), 4))\n",
        "print(\"np.convolve:     \", np.convolve(x, h))\n",
        "print(np.allclose(conv_linear_dft(x, h), np.convolve(x, h)))\n",
        "\n",
        "# sem zero-padding: convolução circular de tamanho 4, resultado errado (aliasing)\n",
        "N = len(x)\n",
        "h_mesmo_tamanho = np.concatenate([h, np.zeros(N - len(h))])\n",
        "sem_padding = np.real(idft(np.sqrt(N) * dft(x) * dft(h_mesmo_tamanho)))\n",
        "print(\"Sem zero-padding:\", np.round(sem_padding, 4))"
      ],
