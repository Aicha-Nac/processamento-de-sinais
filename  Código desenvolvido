        "## 4. Convolução de sequências longas: overlap-add e overlap-save\n",
        "Cálculo da convolução linear em blocos, validado com `np.convolve`."
      ],
      "metadata": {
        "id": "Xplgx9pIBcoL"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def overlap_add(x, h, B):\n",
        "    x = np.asarray(x, dtype=float)\n",
        "    h = np.asarray(h, dtype=float)\n",
        "    M = len(h)\n",
        "    L = B + M - 1  # tamanho da DFT de cada bloco (N_DFT >= N + K - 1)\n",
        "\n",
        "    H = dft(np.concatenate([h, np.zeros(L - M)]))\n",
        "    y = np.zeros(len(x) + M - 1)\n",
        "\n",
        "    for inicio in range(0, len(x), B):\n",
        "        bloco = x[inicio:inicio + B]\n",
        "        bloco_p = np.concatenate([bloco, np.zeros(L - len(bloco))])\n",
        "        y_bloco = np.real(idft(np.sqrt(L) * dft(bloco_p) * H))\n",
        "\n",
        "        # soma o resultado do bloco na posição certa (as caudas se sobrepõem)\n",
        "        fim = min(inicio + L, len(y))\n",
        "        y[inicio:fim] += y_bloco[:fim - inicio]\n",
        "\n",
        "    return y\n",
        "\n",
        "\n",
        "def overlap_save(x, h, L):\n",
        "    x = np.asarray(x, dtype=float)\n",
        "    h = np.asarray(h, dtype=float)\n",
        "    M = len(h)\n",
        "    passo = L - (M - 1)  # amostras válidas por bloco (d = N - K + 1)\n",
        "\n",
        "    H = dft(np.concatenate([h, np.zeros(L - M)]))\n",
        "    tamanho_saida = len(x) + M - 1\n",
        "\n",
        "    # M-1 zeros no início (passo 1 do slide) e zeros no fim para completar o último bloco\n",
        "    xp = np.concatenate([np.zeros(M - 1), x, np.zeros(L)])\n",
        "    y = []\n",
        "\n",
        "    for inicio in range(0, tamanho_saida, passo):\n",
        "        bloco = xp[inicio:inicio + L]\n",
        "        y_bloco = np.real(idft(np.sqrt(L) * dft(bloco) * H))  # convolução circular\n",
        "\n",
        "        # descarta as M-1 primeiras amostras (contaminadas pelo aliasing)\n",
        "        y.extend(y_bloco[M - 1:])\n",
        "\n",
        "    return np.array(y[:tamanho_saida])\n",
        "\n",
        "\n",
        "rng = np.random.default_rng(1)\n",
        "x = rng.integers(0, 10, 20)\n",
        "h = [1, 2, 1]\n",
        "\n",
        "print(\"Overlap-add: \", np.allclose(overlap_add(x, h, B=5), np.convolve(x, h)))\n",
        "print(\"Overlap-save:\", np.allclose(overlap_save(x, h, L=8), np.convolve(x, h)))"
      ],
