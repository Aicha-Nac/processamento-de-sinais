        "import time\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "tamanhos = [2**p for p in range(3, 11)]  # 8, 16, ..., 1024\n",
        "t_dft, t_fft, t_np = [], [], []\n",
        "\n",
        "for N in tamanhos:\n",
        "    x = rng.standard_normal(N)\n",
        "\n",
        "    t0 = time.perf_counter()\n",
        "    X_dft = dft(x)\n",
        "    t_dft.append(time.perf_counter() - t0)\n",
        "\n",
        "    t0 = time.perf_counter()\n",
        "    X_fft = fft(x)\n",
        "    t_fft.append(time.perf_counter() - t0)\n",
        "\n",
        "    t0 = time.perf_counter()\n",
        "    np.fft.fft(x)\n",
        "    t_np.append(time.perf_counter() - t0)\n",
        "\n",
        "    print(f\"N = {N:5d} | DFT: {t_dft[-1]:.5f} s | FFT: {t_fft[-1]:.5f} s | \"\n",
        "          f\"aceleração: {t_dft[-1] / t_fft[-1]:6.1f}x | iguais: {np.allclose(X_dft, X_fft)}\")\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.loglog(tamanhos, t_dft, \"o-\", label=\"DFT manual O(N²)\")\n",
        "plt.loglog(tamanhos, t_fft, \"s-\", label=\"FFT manual O(N log N)\")\n",
        "plt.loglog(tamanhos, t_np, \"^-\", label=\"np.fft.fft\")\n",
        "plt.xlabel(\"Tamanho do sinal N\")\n",
        "plt.ylabel(\"Tempo de execução (s)\")\n",
        "plt.title(\"Comparação de tempo: DFT x FFT\")\n",
        "plt.legend()\n",
        "plt.grid(True, which=\"both\", alpha=0.3)\n",
        "plt.show()"
