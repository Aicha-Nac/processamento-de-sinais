        "def conv_linear_dft(x, h):\n",
        "    x = np.asarray(x, dtype=float)\n",
        "    h = np.asarray(h, dtype=float)\n",
        "    L = len(x) + len(h) - 1\n",
        "\n",
        "    # zero-padding até o tamanho L\n",
        "    xp = np.concatenate([x, np.zeros(L - len(x))])\n",
        "    hp = np.concatenate([h, np.zeros(L - len(h))])\n",
        "\n",
        "    # convolução = multiplicação na frequência\n",
        "    y = idft(dft(xp) * dft(hp))\n",
        "\n",
        "    # o resultado deve ser real; a parte imaginária é só erro de arredondamento\n",
        "    return np.real(y)\n",
        "\n",
        "\n",
        "x = [1, 2, 3, 4]\n",
        "h = [1, 1, 1]\n",
        "\n",
        "print(\"Com zero-padding:\", np.round(conv_linear_dft(x, h), 4))\n",
        "print(\"np.convolve:     \", np.convolve(x, h))\n",
        "print(np.allclose(conv_linear_dft(x, h), np.convolve(x, h)))\n",
        "\n",
        "# sem zero-padding: convolução circular, resultado errado (aliasing)\n",
        "h_mesmo_tamanho = np.concatenate([h, np.zeros(len(x) - len(h))])\n",
        "sem_padding = np.real(idft(dft(x) * dft(h_mesmo_tamanho)))\n",
        "print(\"Sem zero-padding:\", np.round(sem_padding, 4))"
