        "import numpy as np\n",
        "\n",
        "rng = np.random.default_rng(0)\n",
        "N = 8\n",
        "x = rng.standard_normal(N)\n",
        "y = rng.standard_normal(N)\n",
        "X = dft(x)\n",
        "Y = dft(y)\n",
        "n = np.arange(N)\n",
        "k = np.arange(N)\n",
        "\n",
        "# 1. linearidade: DFT(a*x + b*y) = a*X + b*Y\n",
        "a, b = 2, -3\n",
        "print(\"Linearidade:\", np.allclose(dft(a*x + b*y), a*X + b*Y))\n",
        "\n",
        "# 2. deslocamento circular no tempo: x[(n-m) mod N] -> X[k] * e^(-j2πkm/N)\n",
        "m = 3\n",
        "print(\"Deslocamento no tempo:\", np.allclose(dft(np.roll(x, m)), X * np.exp(-1j*2*np.pi*k*m/N)))\n",
        "\n",
        "# 3. deslocamento em frequência: x[n] * e^(j2πln/N) -> X[(k-l) mod N]\n",
        "l = 2\n",
        "print(\"Deslocamento em frequência:\", np.allclose(dft(x * np.exp(1j*2*np.pi*l*n/N)), np.roll(X, l)))\n",
        "\n",
        "# 4. reversão circular no tempo: x[(-n) mod N] -> X[(-k) mod N]\n",
        "print(\"Reversão no tempo:\", np.allclose(dft(x[(-n) % N]), X[(-k) % N]))\n",
        "\n",
        "# 5. simetria conjugada (x real): X[(-k) mod N] = conj(X[k])\n",
        "print(\"Simetria conjugada:\", np.allclose(X[(-k) % N], np.conj(X)))\n",
        "\n",
        "# 6. convolução circular: DFT(x ⊛ y) = X * Y\n",
        "def conv_circular(x, y):\n",
        "    N = len(x)\n",
        "    z = np.zeros(N)\n",
        "    for n in range(N):\n",
        "        for m in range(N):\n",
        "            z[n] += x[m] * y[(n - m) % N]\n",
        "    return z\n",
        "\n",
        "print(\"Convolução circular:\", np.allclose(dft(conv_circular(x, y)), X * Y))\n",
        "\n",
        "# 7. Parseval: energia no tempo = energia na frequência / N\n",
        "print(\"Parseval:\", np.allclose(np.sum(np.abs(x)**2), np.sum(np.abs(X)**2) / N))"
