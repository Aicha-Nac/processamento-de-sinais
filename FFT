        "import numpy as np\n",
        "\n",
        "def dft(x):\n",
        "    x = np.asarray(x, dtype=complex)\n",
        "    N = len(x)\n",
        "    X = np.zeros(N, dtype=complex)\n",
        "\n",
        "    for k in range(N):\n",
        "        soma = 0\n",
        "        for n in range(N):\n",
        "            soma += x[n] * np.exp(-1j * 2 * np.pi * k * n / N)\n",
        "        X[k] = soma\n",
        "\n",
        "    return X\n",
        "\n",
        "\n",
        "# teste\n",
        "x = [1, 1, 1, 1]\n",
        "print(dft(x))\n",
        "print(np.fft.fft(x))  # resultado de referência do numpy\n",
        "\n",
        "print(np.allclose(dft(x), np.fft.fft(x)))"
