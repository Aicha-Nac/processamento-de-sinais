        "def idft(X):\n",
        "    X = np.asarray(X, dtype=complex)\n",
        "    N = len(X)\n",
        "    x = np.zeros(N, dtype=complex)\n",
        "\n",
        "    for n in range(N):\n",
        "        soma = 0\n",
        "        for k in range(N):\n",
        "            soma += X[k] * np.exp(1j * 2 * np.pi * k * n / N)\n",
        "        x[n] = soma / N\n",
        "\n",
        "    return x\n",
        "\n",
        "\n",
        "# teste de ida e volta\n",
        "x = [3, 5, 6, 7]\n",
        "X = dft(x)\n",
        "x_rec = idft(X)\n",
        "\n",
        "print(np.round(x_rec, 4))\n",
        "print(np.allclose(x_rec, x))\n",
        "print(np.allclose(idft(X), np.fft.ifft(X)))  # compara com o numpy"
